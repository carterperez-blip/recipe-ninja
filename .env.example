# Copy to .env.local for local work. On Netlify, set the same names under
# Site configuration > Environment variables. Never commit real values.

# Supabase (Project settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only: used to record AI spend. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (server only)
ANTHROPIC_API_KEY=

# Only this Google account may use the app
ALLOWED_EMAIL=

# Monthly AI limit in US dollars (decided: 10)
AI_MONTHLY_CAP_USD=10
